---
import DataFreshnessNotice from "@shared/components/DataFreshnessNotice.astro";
import PriceCard from "@price/components/PriceCard.astro";
import BaseLayout from "@shared/layouts/BaseLayout.astro";
import {
  buildProductPageData,
  formatPrice,
  getOfferSummary,
  getProductDecision,
  getStore,
  getUpdateLabel,
} from "@price/core/catalog";
import { getSiteData } from "@price/core/loadSiteData";
import { sitePath } from "@shared/core/urls";
import { topics } from "@price/plugins/topicCatalog";
import type { Product } from "@price/core/types";

export async function getStaticPaths() {
  const siteData = await getSiteData();
  const seenSlugs = new Set<string>();

  return siteData.products.flatMap((product) => {
    const slugs = [product.slug, ...(product.aliases ?? [])];

    return slugs
      .filter((slug) => {
        if (seenSlugs.has(slug)) {
          return false;
        }

        seenSlugs.add(slug);
        return true;
      })
      .map((slug) => ({
        params: { slug },
        props: { product },
      }));
  });
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const siteData = await getSiteData();
const pageData = buildProductPageData(siteData, product);
const sortedOffers = [...pageData.offers].sort((a, b) => a.price - b.price);
const updatedAt = sortedOffers[0]?.fetchedAt ?? siteData.generatedAt;
const bestStore = pageData.bestOffer ? getStore(siteData.stores, pageData.bestOffer.storeId) : undefined;
const offerSummary = getOfferSummary(sortedOffers);
const decision = getProductDecision(product, sortedOffers, siteData.stores);
const exactOffers = sortedOffers.filter((offer) => offer.urlType === "product");
const marketOffers = sortedOffers.filter((offer) => offer.urlType === "search");
const comparisonLinks = product.comparisonLinks ?? [];
const officialComparisonLink = comparisonLinks.find((link) => link.kind === "official");
const lowestPrice = sortedOffers[0]?.price ?? 0;
const highestPrice = sortedOffers.at(-1)?.price ?? lowestPrice;
const priceRange = Math.max(highestPrice - lowestPrice, 0);
const rangeDenominator = priceRange || 1;
const channelTip = officialComparisonLink && !offerSummary.officialOffer
  ? `可先用${officialComparisonLink.label}核對規格與建議售價，再看通路商品頁價格與活動條件。`
  : decision.channelTip;
const relatedProducts = siteData.products
  .filter((item) => item.categoryId === product.categoryId && item.slug !== product.slug)
  .slice(0, 4)
  .map((item) => {
    const offers = siteData.offers.filter((offer) => offer.productSlug === item.slug);
    return {
      product: item,
      bestOffer: [...offers].sort((a, b) => a.price - b.price)[0],
      spread: getOfferSummary(offers).spread,
    };
  });
const relatedTopics = topics
  .filter((topic) => topic.productSlugs.includes(product.slug) || topic.categoryIds.includes(product.categoryId))
  .slice(0, 3);
const title = `${product.name} 比價｜今日最低價、價差與購買建議`;
const description = `${product.summary} 整理可驗證價格、官方資訊與常用通路入口。`;
const faqItems = [
  {
    question: `${product.name} 現在值得買嗎？`,
    answer: `${decision.verdict} 如果你只是想快速買到划算價格，可以先看最低價；如果這是高單價或長期使用的商品，建議再順手確認保固、配送速度和退換貨條件。`,
  },
  {
    question: `${product.name} 最低價一定最好嗎？`,
    answer: `${channelTip} 有時候多花一點點換官方保固、快速到貨或更好退貨流程，實際體驗會更安心。`,
  },
  {
    question: `${product.name} 比價要注意什麼？`,
    answer: `${product.buyingAdvice} 最簡單的做法是先看價差，再看通路類型，最後才點出去確認活動門檻。`,
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: product.name,
    description,
    category: pageData.category.name,
    offers: sortedOffers.map((offer) => ({
      "@type": "Offer",
      priceCurrency: offer.currency,
      price: offer.price,
      ...(offer.urlType === "product" ? { url: offer.url } : {}),
      availability: "https://schema.org/InStock",
      seller: {
        "@type": "Organization",
        name: getStore(siteData.stores, offer.storeId)?.name ?? offer.storeId,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "首頁", item: sitePath("/") },
      { "@type": "ListItem", position: 2, name: pageData.category.name, item: sitePath(`/category/${pageData.category.id}/`) },
      { "@type": "ListItem", position: 3, name: product.name, item: sitePath(`/compare/${product.slug}/`) },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={`/compare/${product.slug}/`} structuredData={structuredData}>
  <section class="site-shell section">
    <div class="compare-layout">
      <aside class="compare-summary">
        <a class="text-link" href={sitePath("/")}>回首頁</a>
        <span class="eyebrow">{pageData.category.name}</span>
        <h1 class="page-title">{product.name}</h1>
        <p class="lede">{product.summary}</p>
        {
          pageData.bestOffer && (
            <div class="best-price">
              <span class="muted">目前最低價</span>
              <div class="price">{formatPrice(pageData.bestOffer.price)}</div>
              <p>{bestStore?.name ?? pageData.bestOffer.storeId}</p>
            </div>
          )
        }
        <div class="compact-facts">
          <span>{Math.max(sortedOffers.length, comparisonLinks.length)} 個通路入口</span>
          {offerSummary.spread > 0 && <span>最高價差 {formatPrice(offerSummary.spread)}</span>}
          {product.trendKeyword && <span>趨勢關鍵字：{product.trendKeyword}</span>}
          {product.verificationStatus === "verified-product-page" && <span>商品頁驗證</span>}
          <span>{getUpdateLabel(updatedAt)}</span>
        </div>
      </aside>

      <div>
        <DataFreshnessNotice section="price" generatedAt={siteData.generatedAt} compact />

        <section class="decision-panel" aria-labelledby="decision-title">
          <span class="eyebrow">今日結論</span>
          <h2 id="decision-title">{decision.verdict}</h2>
          <p>{channelTip}</p>
          <div class="decision-grid">
            <div>
              <h3>適合誰</h3>
              <ul>
                {decision.bestFor.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <h3>不適合誰</h3>
              <ul>
                {decision.notBestFor.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>

        <section class="panel simple-panel" aria-labelledby="offers-title">
          <div class="section-heading">
            <div>
              <span class="eyebrow">價格</span>
              <h2 id="offers-title">通路比較</h2>
            </div>
          </div>
          {
            sortedOffers.length > 0 ? (
              <>
                <div class="price-range-panel" aria-label="價格區間">
                  <div class="price-range-head">
                    <div>
                      <span>價格區間</span>
                      <strong>{formatPrice(lowestPrice)} - {formatPrice(highestPrice)}</strong>
                    </div>
                    <p>{priceRange > 0 ? `目前可比價差 ${formatPrice(priceRange)}` : "目前各來源價格接近"}</p>
                  </div>
                  <div class="price-range-track">
                    {sortedOffers.map((offer) => {
                      const position = ((offer.price - lowestPrice) / rangeDenominator) * 100;

                      return (
                        <span
                          class:list={["price-range-dot", offer.urlType === "search" && "market"]}
                          style={`left: ${Math.min(Math.max(position, 0), 100)}%`}
                          title={`${getStore(siteData.stores, offer.storeId)?.name ?? offer.storeId} ${formatPrice(offer.price)}`}
                        />
                      );
                    })}
                  </div>
                  <div class="price-range-labels">
                    <span>{formatPrice(lowestPrice)}</span>
                    <span>{formatPrice(highestPrice)}</span>
                  </div>
                </div>
                <div class="offer-list">
                  {sortedOffers.map((offer) => (
                    <PriceCard offer={offer} store={getStore(siteData.stores, offer.storeId)} />
                  ))}
                </div>
              </>
            ) : (
              <div class="empty-state">
                <strong>價格待補</strong>
                <p>目前沒有可對帳的一對一商品頁來源，因此不顯示價格。等接入合法商品頁爬取或人工驗證來源後，才會重新開放價格。</p>
              </div>
            )
          }
          <p class="fine-print">
            商品頁價格與市場列表參考價會分開標示；市場列表用於建立價格區間，實際庫存、活動門檻與最終結帳價仍以來源頁為準。
          </p>
        </section>

        {
          comparisonLinks.length > 0 && (
            <section class="panel simple-panel" aria-labelledby="channel-links-title">
              <div class="section-heading">
                <div>
                  <span class="eyebrow">通路入口</span>
                  <h2 id="channel-links-title">先確認這幾個地方</h2>
                </div>
              </div>
              <div class="channel-link-grid">
                {comparisonLinks.map((link) => (
                  <a class:list={["channel-link-card", link.kind]} href={link.url} rel="nofollow noopener noreferrer" target="_blank">
                    <span>{link.kind === "official" ? "官方" : link.kind === "product" ? "商品頁" : "搜尋"}</span>
                    <strong>{link.label}</strong>
                    {link.note && <p>{link.note}</p>}
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <section class="section" aria-labelledby="channel-title">
          <div class="section-heading">
            <div>
              <span class="eyebrow">通路摘要</span>
              <h2 id="channel-title">快速判斷</h2>
            </div>
          </div>
          <div class="summary-card-grid">
            <article class="summary-card">
              <span>精準商品頁</span>
              <strong>{exactOffers.length} 個</strong>
              <p>{exactOffers.length > 0 ? "可直接進入確認商品頁" : "目前尚未取得一對一商品 URL"}</p>
            </article>
            <article class="summary-card">
              <span>市場參考</span>
              <strong>{marketOffers.length} 個</strong>
              <p>{marketOffers.length > 0 ? "用於輔助判斷價格帶" : "目前皆為商品頁來源"}</p>
            </article>
            <article class="summary-card">
              <span>最低價</span>
              <strong>{offerSummary.bestOffer ? formatPrice(offerSummary.bestOffer.price) : "待更新"}</strong>
              <p>{offerSummary.bestOffer ? getStore(siteData.stores, offerSummary.bestOffer.storeId)?.name ?? offerSummary.bestOffer.storeId : "尚無資料"}</p>
            </article>
            <article class="summary-card">
              <span>官方/授權</span>
              <strong>{offerSummary.officialOffer ? formatPrice(offerSummary.officialOffer.price) : officialComparisonLink ? "可核對" : "未標記"}</strong>
              <p>{offerSummary.officialOffer ? getStore(siteData.stores, offerSummary.officialOffer.storeId)?.name ?? offerSummary.officialOffer.storeId : officialComparisonLink?.label ?? "點進來源頁確認保固"}</p>
            </article>
            <article class="summary-card">
              <span>跨境提醒</span>
              <strong>{offerSummary.crossBorderOffers.length} 個</strong>
              <p>{offerSummary.crossBorderOffers.length > 0 ? "需留意運費、配送時間與報關" : "目前沒有跨境標記"}</p>
            </article>
          </div>
        </section>

        <section class="section" aria-labelledby="advice-title">
          <div class="section-heading">
            <div>
              <span class="eyebrow">提醒</span>
              <h2 id="advice-title">購買建議</h2>
            </div>
          </div>
          <p class="lede">{product.buyingAdvice}</p>
          <div class="purpose-grid compact-purpose">
            <article>
              <span>看低點</span>
              <h2>歷史價格需要真實快照</h2>
              <p>目前先看同日通路價差；等取得商品頁並累積每日快照後，再顯示真正的歷史趨勢。</p>
            </article>
            <article>
              <span>看風險</span>
              <h2>保固、跨境與運費</h2>
              <p>官方與跨境通路分開看，避免低價背後有等待時間或報關成本。</p>
            </article>
          </div>
          <dl class="spec-list">
            {
              Object.entries(product.specs).map(([label, value]) => (
                <div class="spec-row">
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="section" aria-labelledby="faq-title">
          <div class="section-heading">
            <div>
              <span class="eyebrow">FAQ</span>
              <h2 id="faq-title">常見問題</h2>
            </div>
          </div>
          <div class="faq-list">
            {faqItems.map((item) => <article class="faq-item"><h3>{item.question}</h3><p>{item.answer}</p></article>)}
          </div>
        </section>

        <section class="section" aria-labelledby="related-title">
          <div class="section-heading">
            <div>
              <span class="eyebrow">延伸導購</span>
              <h2 id="related-title">你可能會喜歡</h2>
            </div>
            <a class="text-link" href={sitePath(`/category/${pageData.category.id}/`)}>看全部</a>
          </div>
          {
            relatedTopics.length > 0 && (
              <div class="topic-grid related-topic-grid">
                {relatedTopics.map((topic) => (
                  <a class="topic-card" href={sitePath(`/topics/${topic.slug}/`)}>
                    <span class="eyebrow">{topic.intent}</span>
                    <h3>{topic.title}</h3>
                    <p>{topic.description}</p>
                    <small>{topic.productSlugs.length} 個精選商品</small>
                  </a>
                ))}
              </div>
            )
          }
          <div class="compact-product-list">
            {
              relatedProducts.map((item) => (
                <a class="compact-product-row" href={sitePath(`/compare/${item.product.slug}/`)}>
                  <span>{item.product.name}</span>
                  <strong>{item.bestOffer ? formatPrice(item.bestOffer.price) : "待更新"}</strong>
                  {item.spread > 0 && <small>價差 {formatPrice(item.spread)}</small>}
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </div>

    {
      pageData.bestOffer?.urlType === "product" && (
        <div class="sticky-cta">
          <a class="button" href={pageData.bestOffer.url} rel="nofollow noopener noreferrer" target="_blank">
            看最低價 {formatPrice(pageData.bestOffer.price)}
          </a>
          <a class="button secondary" href={sitePath("/")}>回首頁</a>
        </div>
      )
    }
  </section>
</BaseLayout>
