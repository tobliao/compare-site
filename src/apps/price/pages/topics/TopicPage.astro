---
import ProductCard from "@price/components/ProductCard.astro";
import BaseLayout from "@shared/layouts/BaseLayout.astro";
import { formatPrice, getCategory, getOfferSummary, getProductsByTopic, getUpdateLabel } from "@price/core/catalog";
import { getSiteData } from "@price/core/loadSiteData";
import { sitePath } from "@shared/core/urls";
import { getTopic, topics } from "@price/plugins/topicCatalog";
import type { Topic } from "@price/core/types";

export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const siteData = await getSiteData();
const topicProducts = getProductsByTopic(siteData, getTopic(topic.slug));
const topicProductRows = topicProducts
  .map((product) => ({
    product,
    category: getCategory(product.categoryId),
    offers: siteData.offers.filter((offer) => offer.productSlug === product.slug),
  }))
  .sort((a, b) => getOfferSummary(b.offers).spread - getOfferSummary(a.offers).spread);
const topProduct = topicProductRows[0];
const topSummary = topProduct ? getOfferSummary(topProduct.offers) : undefined;
const relatedTopics = topics
  .filter((item) => item.slug !== topic.slug && item.categoryIds.some((categoryId) => topic.categoryIds.includes(categoryId)))
  .slice(0, 3);
const recommendedProducts = topicProductRows.slice(0, 4);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: topic.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "首頁", item: sitePath("/") },
      { "@type": "ListItem", position: 2, name: "主題導購", item: sitePath("/trends/") },
      { "@type": "ListItem", position: 3, name: topic.title, item: sitePath(`/topics/${topic.slug}/`) },
    ],
  },
];
---

<BaseLayout
  title={`${topic.title}｜最低價、價差與購買建議`}
  description={`${topic.description} 整理相關商品最低價、通路價差、適合族群與常見問題。`}
  canonicalPath={`/topics/${topic.slug}/`}
  structuredData={structuredData}
>
  <section class="site-shell section">
    <div class="page-header">
      <a class="text-link" href={sitePath("/trends/")}>趨勢頁</a>
      <span class="eyebrow">{topic.intent}</span>
      <h1 class="page-title">{topic.title}</h1>
      <p class="lede">{topic.description}</p>
      <div class="summary-bar">
        <span>{getUpdateLabel(siteData.generatedAt)}</span>
        <span>{topicProductRows.length} 個商品</span>
        <span>{topic.audience}</span>
      </div>
      <div class="topic-brief">
        <article>
          <span>先看誰</span>
          <strong>{topProduct?.product.name ?? "商品清單"}</strong>
          <p>{topSummary?.bestOffer ? `目前最低價 ${formatPrice(topSummary.bestOffer.price)}` : "等待下一次更新"}</p>
        </article>
        <article>
          <span>為什麼值得比</span>
          <strong>{topSummary ? `價差 ${formatPrice(topSummary.spread)}` : "價差待更新"}</strong>
          <p>先看價差大的商品，再決定是否進入通路。</p>
        </article>
        <article>
          <span>適合情境</span>
          <strong>{topic.audience}</strong>
          <p>依照需求快速切入，不用從平台首頁重新搜尋。</p>
        </article>
      </div>
      <div class="hero-actions compact-actions">
        <a class="button" href="#topic-products">確定，看商品</a>
        <a class="button secondary" href={sitePath("/deals/")}>看今日價差</a>
      </div>
    </div>

    <section id="topic-products" class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">商品清單</span>
          <h2>依價差排序</h2>
        </div>
      </div>
      <div class="grid product-grid dense-grid">
        {
          topicProductRows.map(({ product, category, offers }) => (
            <ProductCard product={product} category={category} offers={offers} stores={siteData.stores} />
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">FAQ</span>
          <h2>購買前常見問題</h2>
        </div>
      </div>
      <div class="faq-list">
        {
          topic.faq.map((item) => (
            <article class="faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="you-may-like-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">延伸導購</span>
          <h2 id="you-may-like-title">你可能會喜歡</h2>
        </div>
        <a class="text-link" href={sitePath("/trends/")}>回趨勢頁</a>
      </div>
      {
        relatedTopics.length > 0 && (
          <div class="topic-grid related-topic-grid">
            {relatedTopics.map((item) => (
              <a class="topic-card" href={sitePath(`/topics/${item.slug}/`)}>
                <span class="eyebrow">{item.intent}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <small>{item.productSlugs.length} 個精選商品</small>
              </a>
            ))}
          </div>
        )
      }
      <div class="compact-product-list">
        {
          recommendedProducts.map(({ product, offers }) => {
            const summary = getOfferSummary(offers);
            return (
              <a class="compact-product-row" href={sitePath(`/compare/${product.slug}/`)}>
                <span>{product.name}</span>
                <strong>{summary.bestOffer ? formatPrice(summary.bestOffer.price) : "待更新"}</strong>
                {summary.spread > 0 && <small>價差 {formatPrice(summary.spread)} · 適合繼續比較</small>}
              </a>
            );
          })
        }
      </div>
    </section>
  </section>
</BaseLayout>
