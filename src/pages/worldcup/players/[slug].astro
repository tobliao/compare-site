---
import PlayerRoleCard from "../../../components/worldcup/PlayerRoleCard.astro";
import RelatedLinks from "../../../components/worldcup/RelatedLinks.astro";
import SourceDisclosure from "../../../components/worldcup/SourceDisclosure.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { absoluteSiteUrl, sitePath } from "../../../lib/core/urls";
import { worldCupPlayers } from "../../../lib/worldcup/data";
import {
  getMatchupsForTeam,
  getSources,
  getTeamLabel,
  getWorldCupTeam,
  playerStatusLabel,
} from "../../../lib/worldcup/helpers";
import { getPlayerRoleProfile, getRelatedLinksForPlayer } from "../../../lib/worldcup/metrics";
import type { WorldCupPlayer } from "../../../lib/worldcup/types";

export function getStaticPaths() {
  return worldCupPlayers.map((player) => ({
    params: { slug: player.slug },
    props: { player },
  }));
}

interface Props {
  player: WorldCupPlayer;
}

const { player } = Astro.props;
const team = getWorldCupTeam(player.teamSlug);
const matchups = getMatchupsForTeam(player.teamSlug).filter((matchup) => matchup.playerSlugs.includes(player.slug));
const roleProfile = getPlayerRoleProfile(player.slug);
const relatedLinks = getRelatedLinksForPlayer(player.slug);
const sources = getSources([
  ...player.sourceIds,
  ...(team?.sourceIds ?? []),
  ...matchups.flatMap((matchup) => matchup.sourceIds),
]);

const playerFaqs = [
  {
    question: `${player.name} 在 2026 世界盃最值得看什麼？`,
    answer: `${roleProfile.editorialRead} 本頁會追蹤他的角色、影響區域與相關對位。`,
  },
  {
    question: `${player.name} 是否已確定進入最終名單？`,
    answer: `目前狀態是「${playerStatusLabel(player)}」。若不是官方最終名單，本站會以觀察名單方式標示。`,
  },
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: player.name,
    affiliation: team?.name,
    url: absoluteSiteUrl(`/worldcup/players/${player.slug}/`, Astro.site),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: playerFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "賽事分析",
        item: absoluteSiteUrl("/worldcup/", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: player.name,
        item: absoluteSiteUrl(`/worldcup/players/${player.slug}/`, Astro.site),
      },
    ],
  },
];
---

<BaseLayout
  title={`${player.name} 球員分析 | 2026 World Cup`}
  description={`${player.name} 2026 世界盃觀察頁，整理位置、國家隊角色、優勢與關鍵對位。`}
  canonicalPath={`/worldcup/players/${player.slug}/`}
  structuredData={structuredData}
>
  <section class="wc-page-hero">
    <div class="site-shell wc-page-hero-inner">
      <div>
        <a class="wc-back-link" href={sitePath(team ? `/worldcup/teams/${team.slug}/` : "/worldcup/")}>← 回到 {team?.name ?? "World Cup Hub"}</a>
        <span class="wc-kicker">{player.position} · {getTeamLabel(player.teamSlug)}</span>
        <h1>{player.name}</h1>
        <p>{player.summary}</p>
      </div>
      <aside class="wc-scorecard">
        <span>{roleProfile.roleType} · {playerStatusLabel(player)}</span>
        <strong>{roleProfile.oneNumber.value}</strong>
        <small>{roleProfile.oneNumber.label} · {player.club}</small>
      </aside>
    </div>
  </section>

  <section class="site-shell wc-section">
    <PlayerRoleCard profile={roleProfile} />
  </section>

  <section class="site-shell wc-section wc-two-column">
    <article class="wc-panel">
      <span class="wc-kicker">Role</span>
      <h2>他在比賽裡真正影響什麼</h2>
      <p>{player.matchupFocus}</p>
    </article>
    <article class="wc-panel">
      <span class="wc-kicker">Strengths</span>
      <h2>可觀察優勢</h2>
      <ul class="wc-list">
        {player.strengths.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>

  {
    team && (
      <section class="site-shell wc-section">
        <div class="wc-section-heading">
          <div>
            <span class="wc-kicker">Team Context</span>
            <h2>放回 {team.name} 的戰術語境</h2>
          </div>
          <a class="text-link" href={sitePath(`/worldcup/teams/${team.slug}/`)}>看隊伍頁</a>
        </div>
        <article class="wc-panel">
          <p>{team.style}</p>
          <div class="wc-card-meta spacious">
            {team.strengths.map((item) => <small>{item}</small>)}
          </div>
        </article>
      </section>
    )
  }

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">Matchup Context</span>
        <h2>相關對位</h2>
      </div>
      <p>只呈現資訊觀察，不轉成下注方向。</p>
    </div>
    <div class="wc-matchup-grid">
      {
        matchups.map((matchup) => (
          <a class="wc-matchup-card" href={sitePath(`/worldcup/matchups/${matchup.slug}/`)}>
            <span>{matchup.stage}</span>
            <h3>{matchup.title}</h3>
            <p>{matchup.tempoRead}</p>
            <small>{matchup.teamSlugs.map(getTeamLabel).join(" vs ")}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="site-shell wc-section">
    <RelatedLinks links={relatedLinks} />
  </section>

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">FAQ</span>
        <h2>快速理解 {player.name}</h2>
      </div>
    </div>
    <div class="faq-list">
      {
        playerFaqs.map((faq) => (
          <article class="faq-item">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="site-shell wc-section">
    <SourceDisclosure sources={sources} compact />
  </section>
</BaseLayout>
