---
import { formatPrice } from "../lib/core/catalog";
import type { PriceTrendPoint } from "../lib/core/types";

interface Props {
  title: string;
  points: PriceTrendPoint[];
  compact?: boolean;
}

const { title, points, compact = false } = Astro.props;
const prices = points.map((point) => point.price);
const minPrice = Math.min(...prices);
const maxPrice = Math.max(...prices);
const range = Math.max(maxPrice - minPrice, 1);
const width = 320;
const height = compact ? 112 : 148;
const padding = 18;
const step = points.length > 1 ? (width - padding * 2) / (points.length - 1) : 0;
const coords = points.map((point, index) => {
  const x = padding + index * step;
  const y = padding + (1 - (point.price - minPrice) / range) * (height - padding * 2);
  return { ...point, x, y };
});
const linePath = coords.map((point, index) => `${index === 0 ? "M" : "L"} ${point.x} ${point.y}`).join(" ");
const areaPath = `${linePath} L ${width - padding} ${height - padding} L ${padding} ${height - padding} Z`;
const latest = points.at(-1);
const previous = points.at(-2);
const delta = latest && previous ? latest.price - previous.price : 0;
---

{
  points.length > 0 && (
    <article class:list={["trend-chart", compact && "compact"]}>
      <div class="trend-chart-header">
        <div>
          <span class="eyebrow">價格趨勢</span>
          <h3>{title}</h3>
        </div>
        <div class:list={["trend-delta", delta <= 0 && "down"]}>
          {delta === 0 ? "持平" : `${delta > 0 ? "+" : ""}${formatPrice(delta)}`}
        </div>
      </div>
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${title} 最近價格趨勢`}>
        <path class="trend-area" d={areaPath} />
        <path class="trend-line" d={linePath} />
        {coords.map((point) => <circle class="trend-dot" cx={point.x} cy={point.y} r="3.6" />)}
      </svg>
      <div class="trend-chart-meta">
        <span>低點 {formatPrice(minPrice)}</span>
        <span>高點 {formatPrice(maxPrice)}</span>
        {latest && <strong>今日 {formatPrice(latest.price)}</strong>}
      </div>
      {!compact && <p>依目前通路價差與最近更新資料生成趨勢視覺，適合用來快速判斷是否正在接近低點。</p>}
    </article>
  )
}
