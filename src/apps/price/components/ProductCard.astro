---
import { formatPrice, getDiscountSpread } from "@price/core/catalog";
import { sitePath } from "@shared/core/urls";
import type { Category, Offer, Product, Store } from "@price/core/types";

interface Props {
  product: Product;
  category: Category;
  offers: Offer[];
  stores?: Store[];
}

const { product, category, offers, stores = [] } = Astro.props;
const bestOffer = [...offers].sort((a, b) => a.price - b.price)[0];
const bestStore = stores.find((store) => store.id === bestOffer?.storeId);
const spread = getDiscountSpread(offers);
const summary = product.summary.length > 46 ? `${product.summary.slice(0, 46)}...` : product.summary;
const hasOfficial = offers.some((offer) => offer.badges?.includes("official"));
const hasCrossBorder = offers.some((offer) => offer.badges?.includes("cross-border"));
const searchText = [product.name, product.summary, category.name, ...product.keywords].join(" ").toLowerCase();
const channelCount = Math.max(offers.length, product.comparisonLinks?.length ?? 0);
---

<article
  class="product-card"
  data-product-card
  data-search={searchText}
  data-category={category.id}
  data-price={bestOffer?.price ?? 0}
  data-spread={spread}
  data-offers={offers.length}
  data-official={hasOfficial ? "true" : "false"}
  data-cross-border={hasCrossBorder ? "true" : "false"}
>
  <div class="product-card-main">
    <a class="muted" href={sitePath(`/category/${category.id}/`)}>{category.name}</a>
    <h3>{product.name}</h3>
    <p>{summary}</p>
  </div>
  {
    bestOffer ? (
      <div class="product-price-block">
        <span class="muted">最低價</span>
        <div class="price">{formatPrice(bestOffer.price)}</div>
        <span class="muted">{bestStore?.name ?? bestOffer.storeId}</span>
      </div>
    ) : (
      <div class="product-price-block pending">
        <span class="muted">價格待補</span>
        <div class="price">待驗證</div>
        <span class="muted">尚未取得可對帳商品頁</span>
      </div>
    )
  }
  <div class="product-meta">
    <span>{channelCount} 個通路入口</span>
    {spread > 0 && <span>價差 {formatPrice(spread)}</span>}
    {product.verificationStatus === "verified-product-page" && <span>商品頁驗證</span>}
  </div>
  <a class="text-link" href={sitePath(`/compare/${product.slug}/`)}>查看價格</a>
</article>
