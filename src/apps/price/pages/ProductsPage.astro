---
import DataFreshnessNotice from "@shared/components/DataFreshnessNotice.astro";
import ProductCard from "@price/components/ProductCard.astro";
import ProductListControls from "@price/components/ProductListControls.astro";
import BaseLayout from "@shared/layouts/BaseLayout.astro";
import { getCategory, getDiscountSpread, getUpdateLabel } from "@price/core/catalog";
import { getSiteData } from "@price/core/loadSiteData";
import { sitePath } from "@shared/core/urls";

const siteData = await getSiteData();
const productRows = siteData.products
  .map((product) => ({
    product,
    category: getCategory(product.categoryId),
    offers: siteData.offers.filter((offer) => offer.productSlug === product.slug),
  }))
  .sort((a, b) => getDiscountSpread(b.offers) - getDiscountSpread(a.offers));

const categoriesWithCounts = siteData.categories.map((category) => ({
  ...category,
  count: siteData.products.filter((product) => product.categoryId === category.id).length,
}));
---

<BaseLayout
  title="全部商品比價｜Taiwan Price Radar"
  description="瀏覽所有台灣熱搜比價商品，依價差、分類與通路快速找到值得比較的商品。"
  canonicalPath="/products/"
>
  <section class="site-shell section">
    <div class="page-header">
      <a class="text-link" href={sitePath("/")}>回首頁</a>
      <span class="eyebrow">全部商品</span>
      <h1 class="page-title">所有值得比的商品</h1>
      <p class="lede">依價差排序，快速看出哪些商品最值得比較。每個商品都能進一步查看通路價格與購買建議。</p>
    </div>

    <div class="category-strip" aria-label="商品分類">
      {categoriesWithCounts.map((category) => <a class="chip" href={sitePath(`/category/${category.id}/`)}>{category.name} · {category.count}</a>)}
    </div>

    <div class="summary-bar">
      <span>{siteData.products.length} 個商品</span>
      <span>{siteData.offers.length} 筆價格</span>
      <span>{siteData.stores.length} 個來源</span>
      <span>{getUpdateLabel(siteData.generatedAt)}</span>
    </div>

    <div class="coverage-grid" aria-label="熱門分類概覽">
      {
        categoriesWithCounts.map((category) => (
          <article class="coverage-card is-met">
            <span>{category.name}</span>
            <strong>{category.count}</strong>
            <p>{category.description}</p>
          </article>
        ))
      }
    </div>

    <div class="purpose-grid compact-purpose">
      <article>
        <span>高價差</span>
        <h2>優先找省最多的商品</h2>
        <p>預設依價差排序，適合快速找到最值得點進去比較的商品。</p>
      </article>
      <article>
        <span>確定篩選</span>
        <h2>輸入後按確定再更新</h2>
        <p>減少畫面跳動，讓搜尋、排序與快速篩選的目的更清楚。</p>
      </article>
    </div>

    <DataFreshnessNotice section="price" generatedAt={siteData.generatedAt} compact />

    <ProductListControls label="全部商品搜尋與排序" />

    <div class="grid product-grid dense-grid" data-product-grid>
      {
        productRows.map(({ product, category, offers }) => (
          <ProductCard product={product} category={category} offers={offers} stores={siteData.stores} />
        ))
      }
    </div>
  </section>
</BaseLayout>
