{
  "name": "taiwan-price-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "collect": "npm run collect:all",
    "collect:all": "npm run collect:price && npm run collect:worldcup && npm run collect:chisha",
    "collect:price": "tsx scripts/collect.ts",
    "collect:worldcup": "tsx scripts/collect-worldcup.ts",
    "collect:chisha": "tsx scripts/collect-chisha.ts",
    "build": "npm run collect:all && astro build",
    "build:static": "astro build",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "astro": "^6.3.6",
    "fast-xml-parser": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
