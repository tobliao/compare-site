---
import type { SignalItem } from "../../lib/worldcup/metrics";
import SourceConfidenceBadge from "./SourceConfidenceBadge.astro";

interface Props {
  signals: SignalItem[];
  title?: string;
  intro?: string;
}

const { signals, title = "賽前訊號板", intro = "把資訊拆成可追蹤訊號，讓使用者知道回訪時該看什麼。" } = Astro.props;
---

<article class="wc-chart-card">
  <div class="wc-chart-heading">
    <div>
      <span class="wc-kicker">Signal Board</span>
      <h3>{title}</h3>
      <p>{intro}</p>
    </div>
  </div>
  <div class="wc-signal-grid">
    {
      signals.map((signal) => (
        <div class="wc-signal-card">
          <div>
            <span>{signal.category}</span>
            <SourceConfidenceBadge confidence={signal.confidence} />
          </div>
          <strong>{signal.label}</strong>
          <p>{signal.detail}</p>
        </div>
      ))
    }
  </div>
</article>
