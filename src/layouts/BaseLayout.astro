---
import "../styles/global.css";
import { absoluteSiteUrl, sitePath } from "../lib/core/urls";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  structuredData,
} = Astro.props;

const siteName = "Taiwan Price Radar";
const canonicalUrl = absoluteSiteUrl(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <header class="site-shell site-header">
      <a class="brand" href={sitePath("/")} aria-label="Taiwan Price Radar 首頁">
        <span class="brand-mark">PR</span>
        <span>Price Radar</span>
      </a>
      <nav class="nav-links" aria-label="主要導覽">
        <a href={sitePath("/products/")}>全部商品</a>
        <a href={sitePath("/#trends")}>熱門</a>
        <a href={sitePath("/#categories")}>分類</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-shell footer">
      <strong>Taiwan Price Radar</strong>
      <p>
        價格、庫存、運費與活動條件請以來源頁面為準。本站不儲存帳號、付款資訊或個人資料。
      </p>
    </footer>
  </body>
</html>
