---
import RelatedLinks from "../../../components/worldcup/RelatedLinks.astro";
import SignalBoard from "../../../components/worldcup/SignalBoard.astro";
import SourceDisclosure from "../../../components/worldcup/SourceDisclosure.astro";
import TeamRadarChart from "../../../components/worldcup/TeamRadarChart.astro";
import TournamentTimeline from "../../../components/worldcup/TournamentTimeline.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { absoluteSiteUrl, sitePath } from "../../../lib/core/urls";
import { worldCupTeams } from "../../../lib/worldcup/data";
import {
  getMatchupsForTeam,
  getPlayersForTeam,
  getSources,
  getTeamLabel,
  teamStatusLabel,
} from "../../../lib/worldcup/helpers";
import { getRelatedLinksForTeam, getTeamMetricProfile, getTeamSignals } from "../../../lib/worldcup/metrics";
import type { WorldCupTeam } from "../../../lib/worldcup/types";

export function getStaticPaths() {
  return worldCupTeams.map((team) => ({
    params: { slug: team.slug },
    props: { team },
  }));
}

interface Props {
  team: WorldCupTeam;
}

const { team } = Astro.props;
const players = getPlayersForTeam(team.slug);
const matchups = getMatchupsForTeam(team.slug);
const metricProfile = getTeamMetricProfile(team.slug);
const relatedLinks = getRelatedLinksForTeam(team.slug);
const sources = getSources([
  ...team.sourceIds,
  ...players.flatMap((player) => player.sourceIds),
  ...matchups.flatMap((matchup) => matchup.sourceIds),
]);

const teamFaqs = [
  {
    question: `${team.name} 2026 世界盃分析重點是什麼？`,
    answer: `${metricProfile.headline} 本頁會追蹤隊伍風格、近三屆成績、核心球員與賽前訊號。`,
  },
  {
    question: "這個隊伍頁是下注建議嗎？",
    answer: "不是。本站只提供資訊分析、戰術觀察與資料來源整理，不提供 odds、盘口或下注方向。",
  },
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SportsTeam",
    name: team.name,
    sport: "Football",
    url: absoluteSiteUrl(`/worldcup/teams/${team.slug}/`, Astro.site),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: teamFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "賽事分析",
        item: absoluteSiteUrl("/worldcup/", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: team.name,
        item: absoluteSiteUrl(`/worldcup/teams/${team.slug}/`, Astro.site),
      },
    ],
  },
];
---

<BaseLayout
  title={`${team.name} 世界盃分析 | 2026 World Cup`}
  description={`${team.name} 2026 世界盃隊伍頁，整理歷屆成績、戰術風格、核心球員與賽前觀察。`}
  canonicalPath={`/worldcup/teams/${team.slug}/`}
  structuredData={structuredData}
>
  <section class="wc-page-hero">
    <div class="site-shell wc-page-hero-inner">
      <div>
        <a class="wc-back-link" href={sitePath("/worldcup/")}>← 回到 World Cup Hub</a>
        <span class="wc-kicker">{team.shortName} · {team.confederation}</span>
        <h1>{team.name}</h1>
        <p>{team.style}</p>
      </div>
      <aside class="wc-scorecard">
        <span>{teamStatusLabel(team)}</span>
        <strong>{metricProfile.oneNumber.value}</strong>
        <small>{metricProfile.oneNumber.label} · 最佳成績 {team.bestFinish}</small>
      </aside>
    </div>
  </section>

  <section class="site-shell wc-section">
    <TeamRadarChart profile={metricProfile} title={`${team.name} Team Radar`} />
  </section>

  <section class="site-shell wc-section wc-two-column">
    <article class="wc-panel">
      <span class="wc-kicker">Team Profile</span>
      <h2>這支隊伍的第一眼重點</h2>
      <p>{metricProfile.headline}</p>
      <div class="wc-fact-grid">
        <div>
          <span>陣容狀態</span>
          <strong>{team.marketValueLabel ?? "待補資料"}</strong>
        </div>
        <div>
          <span>年齡結構</span>
          <strong>{team.averageAgeLabel ?? "待補資料"}</strong>
        </div>
        <div>
          <span>分析焦點</span>
          <strong>{team.watchPoints[0]}</strong>
        </div>
      </div>
    </article>
    <TournamentTimeline cycles={team.historicalCycles} title={`${team.name} 近三屆走勢`} />
  </section>

  <section class="site-shell wc-section wc-two-column">
    <article class="wc-panel">
      <span class="wc-kicker">Strengths</span>
      <h2>優勢</h2>
      <ul class="wc-list">
        {team.strengths.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article class="wc-panel">
      <span class="wc-kicker">Watch Points</span>
      <h2>真正要看的風險</h2>
      <ul class="wc-list">
        {team.watchPoints.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>

  <section class="site-shell wc-section">
    <SignalBoard signals={getTeamSignals(team.slug)} title={`${team.name} 回訪訊號`} intro="把隊伍頁從一次性閱讀變成可持續追蹤的情報頁。" />
  </section>

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">Key Players</span>
        <h2>{team.name} 的球員觀察</h2>
      </div>
      <p>這裡先放 MVP 追蹤名單，不宣稱是官方最終參賽名單。</p>
    </div>
    <div class="wc-player-grid">
      {
        players.map((player) => (
          <a class="wc-player-card" href={sitePath(`/worldcup/players/${player.slug}/`)}>
            <span>{player.position} · {player.club}</span>
            <h3>{player.name}</h3>
            <p>{player.summary}</p>
            <small>{player.matchupFocus}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">Related Matchups</span>
        <h2>相關對位情境</h2>
      </div>
    </div>
    <div class="wc-matchup-grid">
      {
        matchups.map((matchup) => (
          <a class="wc-matchup-card" href={sitePath(`/worldcup/matchups/${matchup.slug}/`)}>
            <span>{matchup.stage}</span>
            <h3>{matchup.title}</h3>
            <p>{matchup.summary}</p>
            <small>{matchup.teamSlugs.map(getTeamLabel).join(" vs ")}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="site-shell wc-section">
    <RelatedLinks links={relatedLinks} />
  </section>

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">FAQ</span>
        <h2>快速理解 {team.name}</h2>
      </div>
    </div>
    <div class="faq-list">
      {
        teamFaqs.map((faq) => (
          <article class="faq-item">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="site-shell wc-section">
    <SourceDisclosure sources={sources} compact />
  </section>
</BaseLayout>
