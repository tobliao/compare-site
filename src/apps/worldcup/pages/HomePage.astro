---
import DataFreshnessNotice from "@shared/components/DataFreshnessNotice.astro";
import MatchupMeter from "@worldcup/components/MatchupMeter.astro";
import SignalBoard from "@worldcup/components/SignalBoard.astro";
import SourceDisclosure from "@worldcup/components/SourceDisclosure.astro";
import TeamRadarChart from "@worldcup/components/TeamRadarChart.astro";
import BaseLayout from "@shared/layouts/BaseLayout.astro";
import { absoluteSiteUrl, sitePath } from "@shared/core/urls";
import {
  worldCupGeneratedAt,
  worldCupFixtures,
  worldCupInsights,
  worldCupMatchups,
  worldCupPlayers,
  worldCupSources,
  worldCupTeams,
} from "@worldcup/lib/data";
import {
  formatWorldCupUpdatedDate,
  getPlayerLabel,
  getSources,
  getTeamLabel,
  playerStatusLabel,
  teamStatusLabel,
} from "@worldcup/lib/helpers";
import { getMatchupMetricProfile, getPlayerRoleProfile, getTeamMetricProfile, globalSignalBoard } from "@worldcup/lib/metrics";
import { worldCupTopicPages } from "@worldcup/lib/topics";

const officialSources = worldCupSources.filter((source) => source.tier === "official" || source.tier === "public-data");
const sourceIdsForPage = new Set<string>();
worldCupInsights.forEach((insight) => insight.sourceIds.forEach((sourceId) => sourceIdsForPage.add(sourceId)));
worldCupTeams.forEach((team) => team.sourceIds.forEach((sourceId) => sourceIdsForPage.add(sourceId)));
const featuredTeamProfiles = ["france", "japan", "argentina"].map(getTeamMetricProfile);
const featuredMatchupProfile = getMatchupMetricProfile("england-vs-spain-midfield-control");
const hubFaqs = [
  {
    question: "世界盃賽事分析會提供下注建議嗎？",
    answer: "不會。本站只提供隊伍、球員、戰術對位與賽前資訊整理，不提供 odds、盘口、下注方向或博彩導流。",
  },
  {
    question: "這些 World Cup 資料會如何更新？",
    answer: "MVP 階段以官方、公開資料與人工整理為主。GitHub Actions 會定時重新部署頁面，但尚未自動抓取即時賽程、最終名單、傷病或賽前狀態；未確認資訊會標為觀察名單或待官方確認。",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "2026 World Cup 賽事分析",
    inLanguage: "zh-Hant-TW",
    description: "2026 世界盃賽事情報中心，整理隊伍歷史、明星球員、戰術對位與賽前觀察。",
    url: absoluteSiteUrl("/worldcup/", Astro.site),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "首頁",
        item: absoluteSiteUrl("/", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "賽事分析",
        item: absoluteSiteUrl("/worldcup/", Astro.site),
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "World Cup traffic topics",
    itemListElement: worldCupTopicPages.map((topic, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: topic.title,
      url: absoluteSiteUrl(`/worldcup/topics/${topic.slug}/`, Astro.site),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: hubFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="2026 World Cup 賽事分析 | 世界盃情報中心"
  description="2026 世界盃賽事分析首頁，整理隊伍歷史、明星球員、戰術對位與賽前觀察。資訊分析用途，不提供下注建議。"
  canonicalPath="/worldcup/"
  structuredData={structuredData}
>
  <section class="wc-hero">
    <div class="site-shell wc-hero-inner">
      <div class="wc-hero-copy">
        <span class="wc-kicker">World Cup Intelligence</span>
        <h1>看懂一場球，不只看誰名氣大。</h1>
        <p>
          這裡把 2026 World Cup 的隊伍歷史、明星球員、戰術對位與賽前變數整理成可閱讀的情報卡。
          重點是幫使用者理解比賽，而不是給下注方向。
        </p>
        <div class="wc-actions">
          <a class="button wc-button" href={sitePath("/worldcup/#matchups")}>先看對位分析</a>
          <a class="button wc-button secondary" href={sitePath("/worldcup/#teams")}>看追蹤隊伍</a>
        </div>
        <div class="wc-stat-strip" aria-label="世界盃資料摘要">
          <span>{worldCupTeams.length} 支 MVP 追蹤隊伍</span>
          <span>{worldCupPlayers.length} 位明星球員</span>
          <span>{worldCupMatchups.length} 組預熱對位</span>
          <span>更新：{formatWorldCupUpdatedDate()}</span>
        </div>
      </div>
      <aside class="wc-hero-card">
        <span class="wc-kicker">這場該看什麼</span>
        <h2>預熱分析路徑</h2>
        <ol>
          <li>先看兩隊近三屆世界盃的結果與風格變化。</li>
          <li>再看球員角色，而不是只看球星名字。</li>
          <li>最後看位置對位、賽程壓力與資訊可信度。</li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="site-shell wc-section">
    <DataFreshnessNotice section="worldcup" generatedAt={worldCupGeneratedAt} />
  </section>

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">2026 主軸</span>
        <h2>先建立可信資料，再做好看的分析</h2>
      </div>
      <p>官方與公開資料優先；若不是最終名單，就清楚標示為觀察名單或待官方確認。</p>
    </div>
    <div class="wc-insight-grid">
      {
        worldCupInsights.map((insight) => (
          <article class="wc-insight-card">
            <span>{insight.category}</span>
            <h3>{insight.title}</h3>
            <p>{insight.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">Visual Intelligence</span>
        <h2>一眼看懂，不只讀一段話</h2>
      </div>
      <p>用雷達圖、對位條與訊號板增加資訊密度，讓使用者有可以截圖、分享與回訪的內容。</p>
    </div>
    <div class="wc-two-column">
      <TeamRadarChart profile={featuredTeamProfiles[0]} title="France Profile" />
      <TeamRadarChart profile={featuredTeamProfiles[1]} title="Japan Profile" />
    </div>
  </section>

  <section class="site-shell wc-section">
    <div class="wc-two-column">
      <MatchupMeter profile={featuredMatchupProfile} />
      <SignalBoard signals={globalSignalBoard} title="目前最值得追蹤的四個訊號" />
    </div>
  </section>

  <section id="teams" class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">Teams</span>
        <h2>追蹤隊伍與歷史脈絡</h2>
      </div>
      <p>第一版先做高關注隊伍，之後可逐步擴展到完整 48 隊。</p>
    </div>
    <div class="wc-team-grid">
      {
        worldCupTeams.map((team) => (
          <a class="wc-team-card" href={sitePath(`/worldcup/teams/${team.slug}/`)}>
            <span>{team.shortName} · {team.confederation}</span>
            <h3>{team.name}</h3>
            <p>{team.style}</p>
            <strong class="wc-card-callout">{getTeamMetricProfile(team.slug).oneNumber.label} · {getTeamMetricProfile(team.slug).oneNumber.value}</strong>
            <div class="wc-card-meta">
              <small>{teamStatusLabel(team)}</small>
              <small>{team.fifaTitles} 座世界盃冠軍</small>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section id="players" class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">Players</span>
        <h2>明星球員不是資料庫，是比賽變數</h2>
      </div>
      <p>先用 watchlist 方式追蹤，等官方最終名單公布後再更新狀態。</p>
    </div>
    <div class="wc-player-grid">
      {
        worldCupPlayers.slice(0, 8).map((player) => (
          <a class="wc-player-card" href={sitePath(`/worldcup/players/${player.slug}/`)}>
            <span>{player.position} · {getTeamLabel(player.teamSlug)}</span>
            <h3>{player.name}</h3>
            <p>{player.role}</p>
            <strong class="wc-card-callout">{getPlayerRoleProfile(player.slug).roleType}</strong>
            <small>{playerStatusLabel(player)}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section id="matchups" class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">Matchups</span>
        <h2>位置對位與賽前觀察</h2>
      </div>
      <p>用「這場會被誰決定」來包裝資料，避免變成冷冰冰的統計牆。</p>
    </div>
    <div class="wc-matchup-grid">
      {
        worldCupMatchups.map((matchup) => (
          <a class="wc-matchup-card" href={sitePath(`/worldcup/matchups/${matchup.slug}/`)}>
            <span>{matchup.stage}</span>
            <h3>{matchup.title}</h3>
            <p>{matchup.summary}</p>
            <strong class="wc-card-callout">{getMatchupMetricProfile(matchup.slug).decisiveQuestion}</strong>
            <small>{matchup.playerSlugs.slice(0, 3).map(getPlayerLabel).join(" / ")}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">Fixture Watch</span>
        <h2>賽程預熱卡</h2>
      </div>
      <p>正式 fixture 以 FIFA 公告為準，MVP 先呈現高話題情境與需追蹤欄位。</p>
    </div>
    <div class="wc-fixture-grid">
      {
        worldCupFixtures.map((fixture) => (
          <article class="wc-fixture-card">
            <span>{fixture.stage}</span>
            <h3>{getTeamLabel(fixture.homeTeamSlug)} vs {getTeamLabel(fixture.awayTeamSlug)}</h3>
            <p>{fixture.note}</p>
            <small>{fixture.kickoffLabel} · {fixture.venue}</small>
          </article>
        ))
      }
    </div>
  </section>

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">Traffic Topics</span>
        <h2>把搜尋流量接進來的主題頁</h2>
      </div>
      <p>黑馬、金靴、主辦國、48 隊賽制與戰術 explainer 會承接更廣的搜尋意圖。</p>
    </div>
    <div class="wc-topic-grid">
      {
        worldCupTopicPages.slice(0, 8).map((topic) => (
          <a class="wc-topic-card" href={sitePath(`/worldcup/topics/${topic.slug}/`)}>
            <span>{topic.intent}</span>
            <h3>{topic.title}</h3>
            <p>{topic.heroTakeaway}</p>
            <small>{topic.tags.join(" · ")}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="site-shell wc-section">
    <SourceDisclosure sources={[...officialSources, ...getSources([...sourceIdsForPage]).filter((source) => source.tier === "trusted-reference").slice(0, 3)]} />
  </section>

  <section class="site-shell wc-section">
    <div class="wc-section-heading">
      <div>
        <span class="wc-kicker">FAQ</span>
        <h2>先把使用邊界講清楚</h2>
      </div>
    </div>
    <div class="faq-list">
      {
        hubFaqs.map((faq) => (
          <article class="faq-item">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
