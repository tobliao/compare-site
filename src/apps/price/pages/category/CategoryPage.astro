---
import ProductCard from "@price/components/ProductCard.astro";
import ProductListControls from "@price/components/ProductListControls.astro";
import BaseLayout from "@shared/layouts/BaseLayout.astro";
import { getCategory, getDiscountSpread, getUpdateLabel } from "@price/core/catalog";
import { getSiteData } from "@price/core/loadSiteData";
import { sitePath } from "@shared/core/urls";
import type { Category } from "@price/core/types";

export async function getStaticPaths() {
  const siteData = await getSiteData();

  return siteData.categories.map((category) => ({
    params: { id: category.id },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const siteData = await getSiteData();
const products = siteData.products
  .filter((product) => product.categoryId === category.id)
  .map((product) => ({
    product,
    category: getCategory(product.categoryId),
    offers: siteData.offers.filter((offer) => offer.productSlug === product.slug),
  }))
  .sort((a, b) => getDiscountSpread(b.offers) - getDiscountSpread(a.offers));

const relatedCategories = siteData.categories.filter((item) => item.id !== category.id);
---

<BaseLayout
  title={`${category.name} 比價列表｜Taiwan Price Radar`}
  description={`${category.description} 瀏覽 ${category.name} 的商品比價、最低價、價差與購買建議。`}
  canonicalPath={`/category/${category.id}/`}
>
  <section class="site-shell section">
    <div class="page-header">
      <a class="text-link" href={sitePath("/products/")}>全部商品</a>
      <span class="eyebrow">分類</span>
      <h1 class="page-title">{category.name}</h1>
      <p class="lede">{category.description}</p>
    </div>

    <div class="summary-bar">
      <span>{products.length} 個熱門品項</span>
      <span>依價差排序</span>
      <span>可進入單品頁查看通路</span>
      <span>{getUpdateLabel(siteData.generatedAt)}</span>
    </div>

    <div class="coverage-card wide">
      <span>本類熱門觀察</span>
      <strong>{products.length} 個品項</strong>
      <p>依近期搜尋熱度與可驗證通路整理，適合先瀏覽趨勢商品，再點進單品比較價格與來源。</p>
    </div>

    <div class="purpose-grid compact-purpose">
      <article>
        <span>分類用途</span>
        <h2>只看這一類商品</h2>
        <p>把同類需求放在一起，適合先比較價差，再挑單品頁看細節。</p>
      </article>
      <article>
        <span>快速決策</span>
        <h2>最低價、通路數、跨境提醒</h2>
        <p>卡片保留購買決策必要資訊，避免從平台首頁重新搜尋。</p>
      </article>
    </div>

    <ProductListControls label={`${category.name} 搜尋與排序`} />

    <div class="grid product-grid dense-grid" data-product-grid>
      {
        products.map(({ product, category, offers }) => (
          <ProductCard product={product} category={category} offers={offers} stores={siteData.stores} />
        ))
      }
    </div>

    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">其他分類</span>
          <h2>繼續瀏覽</h2>
        </div>
      </div>
      <div class="chip-list">
        {relatedCategories.map((item) => <a class="chip" href={sitePath(`/category/${item.id}/`)}>{item.name}</a>)}
      </div>
    </section>
  </section>
</BaseLayout>
